# =============================================================================
# Prometheus configuration — généré par Ansible (ne pas éditer manuellement)
# =============================================================================

global:
  scrape_interval:     {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_evaluation_interval }}
  external_labels:
    environment: "production"
    cluster: "genuka-infra"

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - "localhost:{{ alertmanager_port }}"

rule_files:
  - "{{ prometheus_config_dir }}/rules/*.yml"

scrape_configs:

  # --- Prometheus lui-même ---
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:{{ prometheus_port }}"]

  # --- Node Exporter — tous les serveurs ---
  - job_name: "node_exporter"
    static_configs:
      - targets:
{% for target in prometheus_node_exporter_targets %}
          - "{{ target }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        regex: "([^:]+):\\d+"
        target_label: instance

  # --- Alertmanager ---
  - job_name: "alertmanager"
    static_configs:
      - targets: ["localhost:{{ alertmanager_port }}"]

  # --- Loki ---
  - job_name: "loki"
    static_configs:
      - targets: ["localhost:{{ loki_port }}"]

  # --- Grafana ---
  - job_name: "grafana"
    static_configs:
      - targets: ["localhost:{{ grafana_port }}"]

  # ===========================================================================
  # ---- AJOUT CIA : sondes blackbox (ICMP/HTTP/DNS) + PostgreSQL ----
  # ===========================================================================

  # --- Latence inter-site (dashboard VPN, Tier 1) ---
  - job_name: "blackbox_icmp"
    metrics_path: /probe
    params:
      module: [icmp]
    static_configs:
      - targets:
{% for t in blackbox_icmp_targets %}
          - "{{ t }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "{{ blackbox_address }}"

  # --- Site web interne (Tier 2) ---
  - job_name: "blackbox_http_internal"
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
{% for t in blackbox_http_internal_targets %}
          - "{{ t }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "{{ blackbox_address }}"

  # --- Disponibilité NetBox (Tier 2) ---
  - job_name: "blackbox_http_netbox"
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
{% for t in blackbox_http_netbox_targets %}
          - "{{ t }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "{{ blackbox_address }}"

  # --- DNS forwarding (Tier 2) ---
  - job_name: "blackbox_dns"
    metrics_path: /probe
    params:
      module: [dns_udp]
    static_configs:
      - targets:
{% for t in blackbox_dns_targets %}
          - "{{ t }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "{{ blackbox_address }}"

  # --- PostgreSQL via postgres_exporter (Tier 2, hôte BDD/NetBox) ---
  - job_name: "postgres"
    static_configs:
      - targets:
{% for t in postgres_exporter_targets %}
          - "{{ t }}"
{% endfor %}
