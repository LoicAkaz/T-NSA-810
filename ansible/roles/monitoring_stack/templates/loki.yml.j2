# =============================================================================
# Loki configuration — généré par Ansible
# Mode : single binary (monolithique), filesystem storage
# =============================================================================

auth_enabled: false

server:
  http_listen_port: {{ loki_port }}
  grpc_listen_port: 9096
  log_level: warn

common:
  instance_addr: 127.0.0.1
  path_prefix: {{ loki_data_dir }}
  storage:
    filesystem:
      chunks_directory: {{ loki_data_dir }}/chunks
      rules_directory: {{ loki_data_dir }}/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

query_range:
  results_cache:
    cache:
      embedded_cache:
        enabled: true
        max_size_mb: 100

schema_config:
  configs:
    - from: "2024-01-01"
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

limits_config:
  retention_period: {{ loki_retention_period }}
  ingestion_rate_mb: 16
  ingestion_burst_size_mb: 32
  max_query_lookback: {{ loki_retention_period }}

compactor:
  working_directory: {{ loki_data_dir }}/compactor
  retention_enabled: true
  retention_delete_delay: 2h
  delete_request_store: filesystem

ruler:
  alertmanager_url: "http://localhost:{{ alertmanager_port }}"
