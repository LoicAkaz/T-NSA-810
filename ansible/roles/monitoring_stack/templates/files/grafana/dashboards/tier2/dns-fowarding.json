      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg(probe_dns_lookup_time_seconds{job=\"blackbox_dns\", instance=~\"$resolver\"})",
          "refId": "A",
          "legendFormat": "",
          "editorMode": "code"
        }
      ]
    },
    {
