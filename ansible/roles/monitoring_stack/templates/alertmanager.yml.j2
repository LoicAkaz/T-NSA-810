# =============================================================================
# Alertmanager configuration — généré par Ansible
# Les credentials sont injectés depuis Ansible Vault
# =============================================================================

global:
  resolve_timeout: 5m
{% if alertmanager_email_enabled %}
  smtp_smarthost: "{{ alertmanager_email_smarthost }}"
  smtp_from: "{{ alertmanager_email_from }}"
  smtp_auth_username: "{{ alertmanager_email_auth_username }}"
  smtp_auth_password: "{{ alertmanager_email_auth_password }}"
  smtp_require_tls: true
{% endif %}

# Regroupement des alertes pour éviter le flood
route:
  receiver: "default"
  group_by: ["alertname", "instance", "severity"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

  routes:
    - match:
        severity: critical
      receiver: "critical"
      repeat_interval: 1h

    - match:
        severity: warning
      receiver: "default"
      repeat_interval: 4h

receivers:

  - name: "default"
{% if alertmanager_email_enabled %}
    email_configs:
      - to: "{{ alertmanager_email_to }}"
        send_resolved: true
{% endif %}
{% if alertmanager_slack_enabled %}
    slack_configs:
      - api_url: "{{ alertmanager_slack_webhook_url }}"
        channel: "{{ alertmanager_slack_channel }}"
        send_resolved: true
        title: '{% raw %}[{{ .Status | toUpper }}] {{ .CommonAnnotations.summary }}{% endraw %}'
        text: '{% raw %}{{ range .Alerts }}{{ .Annotations.description }}{{ "\n" }}{{ end }}{% endraw %}'
{% endif %}

  - name: "critical"
{% if alertmanager_email_enabled %}
    email_configs:
      - to: "{{ alertmanager_email_to }}"
        send_resolved: true
        headers:
          Subject: '{% raw %}[CRITICAL] {{ .CommonAnnotations.summary }}{% endraw %}'
{% endif %}
{% if alertmanager_slack_enabled %}
    slack_configs:
      - api_url: "{{ alertmanager_slack_webhook_url }}"
        channel: "{{ alertmanager_slack_channel }}"
        send_resolved: true
        color: '{% raw %}{{ if eq .Status "firing" }}danger{{ else }}good{{ end }}{% endraw %}'
        title: '{% raw %}🔴 [CRITICAL] {{ .CommonAnnotations.summary }}{% endraw %}'
        text: '{% raw %}{{ range .Alerts }}{{ .Annotations.description }}{{ "\n" }}{{ end }}{% endraw %}'
{% endif %}

inhibit_rules:
  - source_match:
      severity: critical
    target_match:
      severity: warning
    equal: ["alertname", "instance"]
