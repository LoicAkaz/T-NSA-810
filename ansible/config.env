################################################################################
# Configuration ansible-pull
# Usage: sudo bash bootstrap.sh config.env
################################################################################
# --- Dépôt Git ---
REPO_URL="git@github.com:LoicAkaz/T-NSA-810.git"
REPO_BRANCH="main"
# Chemin du playbook dans le dépôt (depuis la racine)
PLAYBOOK="local.yml"
# --- Identité du serveur ---
# Hostname définitif du serveur (ex: api-prod, db-prod, db-pre-prod)
SERVER_HOSTNAME="api-prod"
# --- Fréquence de pull (cron) ---
# Format: minute heure jour_du_mois mois jour_de_la_semaine
# Exemples:
#   toutes les 10 min : */10 * * * *
#   toutes les heures : 0 * * * *
#   tous les jours à 3h: 0 3 * * *
CRON_SCHEDULE="*/15 * * * *"
# --- Clé SSH pour le dépôt privé ---
# Laisser vide si le dépôt est public
# Sinon: chemin vers la clé privée sur la machine locale (sera copiée sur le VPS)
DEPLOY_KEY_PATH=""
# Chemin de destination sur le serveur
DEPLOY_KEY_DEST="/root/.ssh/ansible_deploy"
# --- Logs ---
LOG_FILE="/var/log/ansible-pull.log"
# Nombre de jours de rétention des logs
LOG_RETENTION_DAYS=30